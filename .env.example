# Google Web OAuth Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Real email delivery — V8 requires SMTP
WANDORA_EMAIL_MODE=smtp
WANDORA_SMTP_HOST=smtp.example.com
WANDORA_SMTP_PORT=587
WANDORA_SMTP_USERNAME=your-smtp-username
WANDORA_SMTP_PASSWORD=your-smtp-password
WANDORA_FROM_EMAIL=no-reply@example.com
WANDORA_FROM_NAME=Wandora

# Strong random secret for JWT sessions
WANDORA_SECRET_KEY=replace-with-a-long-random-secret
